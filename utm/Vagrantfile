# -*- mode: ruby -*-
# vi: set ft=ruby :

# UTM VM definitions for plat-telemetry
# Uses vagrant_utm provider: https://github.com/naveenrajm7/vagrant_utm
# Managed via: VM=<name> mise run utm:<task>

Vagrant.configure("2") do |config|
  # Default provider settings
  config.vm.provider :utm do |utm|
    utm.memory = 4096
    utm.cpus = 2
  end

  # =============================================================================
  # Linux VMs (boxes from utm-gallery, all autostart: false — use VM= to select)
  # =============================================================================

  config.vm.define "ubuntu", autostart: false do |vm|
    vm.vm.box = "utm/ubuntu-24.04"
    vm.vm.hostname = "ubuntu"
    vm.vm.network "forwarded_port", guest: 22, host: 2224, id: "ssh"
    vm.vm.provider :utm do |utm|
      utm.name = "plat-ubuntu"
    end
  end

  config.vm.define "debian", autostart: false do |vm|
    vm.vm.box = "utm/bookworm"
    vm.vm.hostname = "debian"
    vm.vm.network "forwarded_port", guest: 22, host: 2225, id: "ssh"
    vm.vm.provider :utm do |utm|
      utm.name = "plat-debian"
    end
  end

  config.vm.define "alpine", autostart: false do |vm|
    vm.vm.box = "utm/alpine-ce"
    vm.ssh.shell = "sh -l"
    vm.vm.synced_folder ".", "/vagrant", disabled: true
    vm.vm.allow_fstab_modification = false
    vm.vm.network "forwarded_port", guest: 22, host: 2223, id: "ssh"
    vm.vm.provider :utm do |utm|
      utm.name = "plat-alpine"
      utm.memory = 2048
    end
  end

  # =============================================================================
  # Windows VM (pre-built box from utm-gallery, downloaded automatically on first run)
  # =============================================================================

  config.vm.define "windows", autostart: false do |vm|
    vm.vm.box = "utm/windows-11"
    vm.vm.hostname = "windows"
    vm.vm.communicator = "winrm"
    vm.winrm.username = "vagrant"
    vm.winrm.password = "vagrant"
    vm.winrm.transport = :plaintext
    vm.winrm.basic_auth_only = true
    vm.vm.synced_folder ".", "/vagrant", disabled: true

    vm.vm.network "forwarded_port", guest: 5985, host: 55985, id: "winrm"

    vm.vm.provider :utm do |utm|
      utm.name = "plat-windows"
      utm.memory = 8192
      utm.cpus = 4
      utm.check_guest_additions = false
    end

    # Install mise, git, clone repo, run mise install (runs on first boot)
    vm.vm.provision "setup", type: "shell",
      privileged: true,
      path: "windows-provision.ps1"

    # Run CI — trigger with: mise run utm:windows:ci
    # Must NOT be privileged — mise.exe fails when run as SYSTEM (elevated)
    # Pass DOPPLER_TOKEN from host env so doppler can inject secrets in the VM
    vm.vm.provision "ci", type: "shell", run: "never",
      privileged: false,
      path: "windows-ci.ps1",
      env: { "DOPPLER_TOKEN" => ENV.fetch("DOPPLER_TOKEN", "") }
  end

  # =============================================================================
  # macOS VM (Apple Silicon only, requires custom box - see README)
  # =============================================================================

  config.vm.define "macos", autostart: false do |vm|
    vm.vm.box = "macos-sequoia-arm64"
    vm.vm.hostname = "macos"
    vm.vm.provider :utm do |utm|
      utm.name = "plat-macos"
      utm.memory = 8192
      utm.cpus = 4
    end
  end
end
